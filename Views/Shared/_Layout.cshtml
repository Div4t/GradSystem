<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GradSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GradSystem.styles.css" asp-append-version="true" />
    @* Tema carga primero para evitar flash al pintar *@
    <script src="~/js/tema.js" asp-append-version="true"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🎓 GradSystem
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">

                    @* \1 *@
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Registro" asp-action="Formulario">
                                Registrarse
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Registro" asp-action="Consulta">
                                Consultar Folio
                            </a>
                        </li>
                    </ul>

                    @* \1 *@
                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    ⚙️ Panel Admin
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Admin" asp-action="Logout"
                                      method="post" class="d-inline m-0">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Login">
                                    🔐 Iniciar Sesión
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <button id="btn-tema" class="btn btn-outline-light"
                                    title="Cambiar modo">🌙</button>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year GradSystem
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
