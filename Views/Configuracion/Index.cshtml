@using GradSystem.Models
@{
    ViewData["Title"] = "Configuración del Formulario";
    string tabActiva = ViewBag.Tab ?? "universidades";

    var universidades = (List<UniversidadCatalogo>)ViewBag.Universidades;
    var colores       = (List<ColorJersey>)ViewBag.Colores;
    var tallas        = (List<TallaCatalogo>)ViewBag.Tallas;
    var dedicatorias  = (List<DedicatoriaCatalogo>)ViewBag.Dedicatorias;
    var titulos       = (List<TituloCatalogo>)ViewBag.Titulos;
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Panel Admin</a>
    <h5 class="mb-0 fw-bold">⚙️ Configuración del Formulario</h5>
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "universidades" ? "active" : "")"
           asp-action="Index" asp-route-tab="universidades">
            🏫 Universidades
            <span class="badge bg-secondary ms-1">@universidades.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "colores" ? "active" : "")"
           asp-action="Index" asp-route-tab="colores">
            🎨 Colores de Jersey
            <span class="badge bg-secondary ms-1">@colores.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "tallas" ? "active" : "")"
           asp-action="Index" asp-route-tab="tallas">
            📏 Tallas
            <span class="badge bg-secondary ms-1">@tallas.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "dedicatorias" ? "active" : "")"
           asp-action="Index" asp-route-tab="dedicatorias">
            💬 Dedicatorias
            <span class="badge bg-secondary ms-1">@dedicatorias.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "titulos" ? "active" : "")"
           asp-action="Index" asp-route-tab="titulos">
            🎓 Abreviaturas
            <span class="badge bg-secondary ms-1">@titulos.Count</span>
        </a>
    </li>
</ul>

@* ════════════════════════════════ UNIVERSIDADES ═══════════════════════════ *@
@if (tabActiva == "universidades")
{
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Universidades disponibles en el formulario</span>
            <small class="opacity-75">Los cambios se reflejan inmediatamente</small>
        </div>
        <div class="card-body">
            <form asp-action="AgregarUniversidad" method="post" class="row g-2 mb-4">
                <div class="col-auto" style="width:120px">
                    <input type="text" name="siglas" class="form-control"
                           placeholder="Ej. UDEM" maxlength="20" required />
                </div>
                <div class="col">
                    <input type="text" name="nombre" class="form-control"
                           placeholder="Ej. UDEM Universidad de Monterrey" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">+ Agregar</button>
                </div>
            </form>

            @if (!universidades.Any())
            {
                <p class="text-muted text-center py-3">No hay universidades registradas.</p>
            }
            else
            {
                @* Formularios ocultos de edición (uno por fila) *@
                @foreach (var u in universidades)
                {
                    <form id="edit-uni-@u.Id"
                          asp-action="EditarUniversidad" asp-route-id="@u.Id"
                          method="post" class="d-none"></form>
                    <form id="del-uni-@u.Id"
                          asp-action="EliminarUniversidad" asp-route-id="@u.Id"
                          method="post" class="d-none"
                          onsubmit="return confirm('¿Eliminar esta universidad?')"></form>
                }

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:70px">Orden</th>
                                <th style="width:110px">Siglas</th>
                                <th>Universidad</th>
                                <th class="text-center" style="width:90px">Activo</th>
                                <th class="text-center" style="width:160px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in universidades)
                            {
                                <tr class="@(!u.Activo ? "opacity-50" : "")">
                                    <td>
                                        <input type="number" name="orden" value="@u.Orden"
                                               form="edit-uni-@u.Id"
                                               class="form-control form-control-sm" style="width:65px" />
                                    </td>
                                    <td>
                                        <input type="text" name="siglas" value="@u.Siglas"
                                               form="edit-uni-@u.Id"
                                               class="form-control form-control-sm text-uppercase"
                                               maxlength="20" required />
                                    </td>
                                    <td>
                                        <input type="text" name="nombre" value="@u.Nombre"
                                               form="edit-uni-@u.Id"
                                               class="form-control form-control-sm" required />
                                    </td>
                                    <td class="text-center">
                                        <input class="form-check-input" type="checkbox"
                                               name="activo" value="true"
                                               form="edit-uni-@u.Id"
                                               @(u.Activo ? "checked" : "") />
                                    </td>
                                    <td class="text-center">
                                        <button type="submit" form="edit-uni-@u.Id"
                                                class="btn btn-warning btn-sm">💾 Guardar</button>
                                        <button type="submit" form="del-uni-@u.Id"
                                                class="btn btn-danger btn-sm">🗑</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

