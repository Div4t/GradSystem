@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <div style="font-size: 4rem;">🎓</div>
    <h1 class="display-5 fw-bold mt-3">Paquetes de Graduación</h1>
    <p class="lead text-muted mb-5">
        Registra tu pedido de paquete de graduación o consulta el estado de uno existente.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Registro" asp-action="Formulario"
           class="btn btn-dark btn-lg px-5">
            Registrarme
        </a>
        <a asp-controller="Registro" asp-action="Consulta"
           class="btn btn-outline-dark btn-lg px-5">
            Consultar mi folio
        </a>
    </div>
</div>
