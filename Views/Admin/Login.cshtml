@{
    ViewData["Title"] = "Acceso Administrador";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-sm-8 col-md-5 col-lg-4">

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-dark text-white text-center py-4">
                <div style="font-size: 2.5rem;">🔐</div>
                <h4 class="mb-0 mt-1">Panel de Administración</h4>
            </div>
            <div class="card-body p-4">

                @if (ViewBag.Error is not null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <span class="me-2">⚠️</span>@ViewBag.Error
                    </div>
                }

                <form method="post" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Correo electrónico</label>
                        <input type="email" id="email" name="email"
                               class="form-control" placeholder="admin@grad.com"
                               required autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">Contraseña</label>
                        <input type="password" id="password" name="password"
                               class="form-control"
                               required autocomplete="current-password" />
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox"
                               id="recordar" name="recordar" value="true" />
                        <label class="form-check-label text-muted" for="recordar">
                            Mantener sesión iniciada
                        </label>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark btn-lg">Iniciar Sesión</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
